pipeline {
    agent {
        kubernetes {
            cloud 'giant-cluster'
            defaultContainer 'helm'
            yaml """
apiVersion: v1
kind: Pod
metadata:
  labels:
    jenkins-agent: helm-publisher
spec:
  serviceAccountName: jenkins-agent
  containers:
  - name: jnlp
    image: jenkins/inbound-agent:latest
    workingDir: /home/jenkins/agent
  - name: helm
    image: alpine/helm:3.16.4
    command:
    - /bin/sh
    - -c
    - "cat"
    tty: true
    workingDir: /home/jenkins/agent
"""
        }
    }
    stages {
        stage('Package & Push Chart to Harbor') {
            steps {
                container('helm') {
                    sh """#!/bin/sh
set -e
echo "Packaging generic-app Helm chart..."
cd \${WORKSPACE}/generic-app
helm package .

echo "Logging into Harbor OCI registry..."
echo "admin" | helm registry login registry.ratlab.dev:8443 --username admin --password-stdin --insecure

echo "Pushing generic-app chart to Harbor OCI..."
CHART_PACKAGE=\$(ls generic-app-*.tgz | head -n 1)
helm push "\${CHART_PACKAGE}" oci://registry.ratlab.dev:8443/library
echo "Chart successfully published to Harbor."
"""
                }
            }
        }
    }
}
