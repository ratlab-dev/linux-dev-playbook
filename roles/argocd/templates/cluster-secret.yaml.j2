apiVersion: v1
kind: Secret
metadata:
  name: cluster-{{ cluster_item.name }}
  namespace: {{ argocd_namespace }}
  labels:
    argocd.argoproj.io/secret-type: cluster
{% for k, v in (cluster_item.labels | default({})).items() %}
    {{ k }}: "{{ v }}"
{% endfor %}
type: Opaque
stringData:
  name: "{{ cluster_item.name }}"
  server: "{{ 'https://kubernetes.default.svc' if cluster_item.is_management_cluster | default(false) else ('https://' ~ (tailscale_node_ip | default(ansible_default_ipv4.address)) ~ ':' ~ (cluster_item.api_port | default(6443))) }}"
  config: "{}"
