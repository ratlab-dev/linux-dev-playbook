# Managed by Ansible (roles/dns)
# dnsmasq configuration for {{ dns_domain }}

# Bind dynamically to all local interfaces (Tailscale, loopback, Docker bridges, LAN)
bind-dynamic

# On Debian/Ubuntu, systemd-helper adds '--local-service' by default, which only accepts
# queries from hosts whose IP matches an interface's local subnet. Because Tailscale
# assigns a /32 point-to-point subnet to tailscale0, queries from other Tailscale peers
# are rejected as "non-local network".
# By dnsmasq design, specifying '--except-interface' disables '--local-service' while
# retaining dynamic binding across all interfaces.
except-interface=none

# Never forward plain names without dots
domain-needed
# Never forward addresses in non-routed address spaces
bogus-priv

# Do not read default /etc/hosts to prevent returning 127.0.1.1 for devbox
no-hosts

# Watch dynamic hosts directory for service registration and node onboarding
# inotify automatically detects new, updated, and deleted records with zero downtime
hostsdir={{ dns_hosts_dir | default('/etc/dnsmasq.hosts.d') }}

# Upstream DNS forwarders
no-resolv
{% for server in dns_upstream_servers %}
server={{ server }}
{% endfor %}

# Wildcard root domain mapping: *.{{ dns_domain }} -> {{ tailscale_node_ip | default(ansible_default_ipv4.address) }}
address=/{{ dns_domain }}/{{ tailscale_node_ip | default(ansible_default_ipv4.address) }}

# Explicit and custom hostname records
{% for record in dns_custom_records %}
address=/{{ record.name }}/{{ record.ip }}
{% endfor %}

# Cache size
cache-size=1000
