# Managed by Ansible (roles/jenkins)
# Nginx Reverse Proxy for Jenkins CI & OpenID Connect Discovery

server {
    listen 443 ssl;
    server_name {{ jenkins_domain | default('jenkins.' ~ internal_domain) }};

    ssl_certificate /etc/ssl/certs/ratlab_wildcard.crt;
    ssl_certificate_key /etc/ssl/private/ratlab_wildcard.key;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    client_max_body_size 1024M;

    # OpenID Connect Discovery document rewrite/alias for Workload Identity
    location = /.well-known/openid-configuration {
        proxy_pass http://127.0.0.1:{{ jenkins_http_port | default(8088) }}/oidc/.well-known/openid-configuration;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # OpenID Connect JWKS endpoint rewrite/alias
    location = /jwks {
        proxy_pass http://127.0.0.1:{{ jenkins_http_port | default(8088) }}/oidc/jwks;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Main Jenkins UI and Agent WebSocket proxy
    location / {
        proxy_pass http://127.0.0.1:{{ jenkins_http_port | default(8088) }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 90s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
    }
}
