import yaml
import os
import base64
import json

# Load Ratlab Root CA
with open('/etc/ssl/certs/ratlab-root-ca.pem', 'r') as f:
    root_ca_pem = f.read()
root_ca_b64 = base64.b64encode(root_ca_pem.encode('utf-8')).decode('utf-8')

clusters_json = '''{{ kind_clusters | to_json }}'''
clusters_def = json.loads(clusters_json)
tailscale_ip = "{{ tailscale_node_ip | default(ansible_default_ipv4.address) }}"

# Structure for local devbox kubeconfig
local_kubeconfig = {
    'apiVersion': 'v1',
    'kind': 'Config',
    'clusters': [],
    'contexts': [],
    'users': [],
    'current-context': clusters_def[0]['name'] if clusters_def else ''
}

# Structure for remote workstation kubeconfig
remote_kubeconfig = {
    'apiVersion': 'v1',
    'kind': 'Config',
    'clusters': [],
    'contexts': [],
    'users': [],
    'current-context': clusters_def[0]['name'] if clusters_def else ''
}

for cluster in clusters_def:
    c_name = cluster['name']
    c_domain = cluster['domain']
    c_port = cluster.get('api_port', 6443)
    k_path = f"/root/.kube/{c_name}.kubeconfig"
    token_path = f"/root/.kube/{c_name}-admin.token"

    token = ""
    if os.path.exists(token_path):
        with open(token_path, 'r') as f:
            token = f.read().strip()

    if os.path.exists(k_path):
        with open(k_path, 'r') as f:
            raw = yaml.safe_load(f)

        src_cluster = raw.get('clusters', [{}])[0].get('cluster', {})
        src_user = raw.get('users', [{}])[0].get('user', {})

        # Local cluster entry (direct mTLS on localhost:port)
        local_kubeconfig['clusters'].append({
            'name': c_name,
            'cluster': {
                'server': f"https://127.0.0.1:{c_port}",
                'certificate-authority-data': src_cluster.get('certificate-authority-data', '')
            }
        })
        local_kubeconfig['users'].append({
            'name': f"admin-{c_name}",
            'user': {
                'client-certificate-data': src_user.get('client-certificate-data', ''),
                'client-key-data': src_user.get('client-key-data', '')
            }
        })
        local_kubeconfig['contexts'].append({
            'name': c_name,
            'context': {
                'cluster': c_name,
                'user': f"admin-{c_name}"
            }
        })

        # Local cluster via Nginx entry
        if token:
            local_kubeconfig['clusters'].append({
                'name': f"{c_name}-nginx",
                'cluster': {
                    'server': f"https://{c_domain}",
                    'certificate-authority-data': root_ca_b64
                }
            })
            local_kubeconfig['users'].append({
                'name': f"token-{c_name}",
                'user': {
                    'token': token
                }
            })
            local_kubeconfig['contexts'].append({
                'name': f"{c_name}-nginx",
                'context': {
                    'cluster': f"{c_name}-nginx",
                    'user': f"token-{c_name}"
                }
            })

    # Remote workstation entry (via Nginx over Tailscale with Root CA)
    if token:
        remote_kubeconfig['clusters'].append({
            'name': c_name,
            'cluster': {
                'server': f"https://{c_domain}",
                'certificate-authority-data': root_ca_b64
            }
        })
        remote_kubeconfig['users'].append({
            'name': f"admin-{c_name}",
            'user': {
                'token': token
            }
        })
        remote_kubeconfig['contexts'].append({
            'name': c_name,
            'context': {
                'cluster': c_name,
                'user': f"admin-{c_name}"
            }
        })

# Write local devbox config
os.makedirs('/root/.kube', exist_ok=True)
with open('/root/.kube/config', 'w') as f:
    yaml.dump(local_kubeconfig, f, default_flow_style=False)
os.chmod('/root/.kube/config', 0o600)

# Write remote workstation config
with open('/tmp/ratlab-workstation.kubeconfig', 'w') as f:
    yaml.dump(remote_kubeconfig, f, default_flow_style=False)
os.chmod('/tmp/ratlab-workstation.kubeconfig', 0o644)

print("Kubeconfigs successfully generated for local and remote usage.")
