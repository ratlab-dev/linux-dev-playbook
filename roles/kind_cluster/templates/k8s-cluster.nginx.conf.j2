# Managed by Ansible (roles/kind_cluster)
# Expose {{ current_cluster.name }} Kubernetes API through Nginx reverse proxy

server {
    listen 443 ssl;
    server_name {{ current_cluster.domain }}{% if current_cluster.alt_domain is defined %} {{ current_cluster.alt_domain }}{% endif %};

    ssl_certificate {{ cluster_cert_path }};
    ssl_certificate_key {{ cluster_key_path }};

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    client_max_body_size 0;

    location / {
        proxy_pass https://127.0.0.1:{{ current_cluster.api_port | default(6443) }};
        proxy_ssl_verify off;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
