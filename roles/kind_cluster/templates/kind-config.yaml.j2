kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
networking:
  apiServerAddress: "127.0.0.1"
  apiServerPort: {{ current_cluster.api_port | default(6443) }}
nodes:
- role: control-plane
  kubeadmConfigPatches:
  - |
    apiVersion: kubeadm.k8s.io/v1beta4
    kind: ClusterConfiguration
    apiServer:
      certSANs:
      - "127.0.0.1"
      - "{{ tailscale_node_ip | default(ansible_default_ipv4.address) }}"
      - "{{ current_cluster.domain }}"
{% if current_cluster.alt_domain is defined %}
      - "{{ current_cluster.alt_domain }}"
{% endif %}
      - "{{ current_cluster.name }}"
