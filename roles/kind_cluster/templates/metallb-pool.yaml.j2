apiVersion: metallb.io/v1beta1
kind: IPAddressPool
metadata:
  name: {{ current_cluster.name }}-pool
  namespace: metallb-system
spec:
  addresses:
  - {{ metallb_pool_range }}
---
apiVersion: metallb.io/v1beta1
kind: L2Advertisement
metadata:
  name: {{ current_cluster.name }}-l2
  namespace: metallb-system
spec:
  ipAddressPools:
  - {{ current_cluster.name }}-pool
