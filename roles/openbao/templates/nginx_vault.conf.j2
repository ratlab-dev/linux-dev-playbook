# Managed by Ansible (roles/openbao)
# Nginx Reverse Proxy for Ratlab Services
# Vault uses exact cert; all other services use wildcard *.{{ internal_domain }}

# HTTP -> HTTPS redirect
server {
    listen 80;
    server_name {{ openbao_domain }} *.{{ internal_domain }};
    return 301 https://$host$request_uri;
}

# 1. OpenBao (Exact Certificate)
server {
    listen 443 ssl;
    server_name {{ openbao_domain }};

    ssl_certificate {{ openbao_tls_dir }}/vault.crt;
    ssl_certificate_key {{ openbao_tls_dir }}/vault.key;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    client_max_body_size 64M;

    location / {
        proxy_pass http://127.0.0.1:{{ openbao_port }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_connect_timeout 60s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
    }
}

# 2. Gitea (Wildcard Certificate)
server {
    listen 443 ssl;
    server_name {{ gitea_domain | default('git.' ~ internal_domain) }};

    ssl_certificate /etc/ssl/certs/ratlab_wildcard.crt;
    ssl_certificate_key /etc/ssl/private/ratlab_wildcard.key;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    client_max_body_size 512M;

    location / {
        proxy_pass https://127.0.0.1:{{ gitea_http_port | default(3000) }};
        proxy_ssl_verify off;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}

# 3. Harbor / Container Registry (Wildcard Certificate)
server {
    listen 443 ssl;
    server_name {{ harbor_domain | default('registry.' ~ internal_domain) }} harbor.{{ internal_domain }};

    ssl_certificate /etc/ssl/certs/ratlab_wildcard.crt;
    ssl_certificate_key /etc/ssl/private/ratlab_wildcard.key;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    client_max_body_size 4096M;

    location / {
        proxy_pass https://127.0.0.1:{{ harbor_https_port | default(8443) }};
        proxy_ssl_verify off;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}

# 4. Default Wildcard Fallback for all other *.{{ internal_domain }}
server {
    listen 443 ssl default_server;
    server_name *.{{ internal_domain }};

    ssl_certificate /etc/ssl/certs/ratlab_wildcard.crt;
    ssl_certificate_key /etc/ssl/private/ratlab_wildcard.key;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    location / {
        return 404 "Service not configured on this host\n";
    }
}
